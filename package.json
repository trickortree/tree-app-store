{
  "name": "tree-app-store",
  "version": "0.1.8",
  "description": "Tree App Store",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "release": "node scripts/release.js"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "build": {
    "appId": "com.trickortree.treeappstore",
    "productName": "Tree App Store",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "renderer.js",
      "apps.json",
      "package.json",
      "build/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Tree-App-Store-Setup-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "trickortree",
      "repo": "tree-app-store",
      "releaseType": "release"
    }
  }
}
